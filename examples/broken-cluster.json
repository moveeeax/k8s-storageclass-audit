{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "storage.k8s.io/v1",
      "kind": "StorageClass",
      "metadata": {
        "name": "standard",
        "annotations": {"storageclass.kubernetes.io/is-default-class": "true"}
      },
      "provisioner": "kubernetes.io/aws-ebs",
      "reclaimPolicy": "Delete",
      "volumeBindingMode": "Immediate",
      "parameters": {"type": "gp2"}
    },
    {
      "apiVersion": "storage.k8s.io/v1",
      "kind": "StorageClass",
      "metadata": {"name": "gp3-retain"},
      "provisioner": "ebs.csi.aws.com",
      "reclaimPolicy": "Retain",
      "volumeBindingMode": "WaitForFirstConsumer",
      "allowVolumeExpansion": true,
      "parameters": {"type": "gp3"}
    },
    {
      "apiVersion": "storage.k8s.io/v1",
      "kind": "StorageClass",
      "metadata": {"name": "io1-legacy"},
      "provisioner": "ebs.csi.aws.com",
      "reclaimPolicy": "Retain",
      "volumeBindingMode": "WaitForFirstConsumer",
      "allowVolumeExpansion": true,
      "parameters": {"type": "io1", "iopsPerGB": "50"}
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {"name": "postgres", "namespace": "data"},
      "spec": {
        "serviceName": "postgres",
        "replicas": 3,
        "volumeClaimTemplates": [
          {
            "metadata": {"name": "pgdata"},
            "spec": {"accessModes": ["ReadWriteOnce"], "resources": {"requests": {"storage": "200Gi"}}}
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {"name": "prometheus-data", "namespace": "monitoring"},
      "spec": {"storageClassName": "fast-ssd", "accessModes": ["ReadWriteOnce"]}
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {"name": "registry", "namespace": "kube-system"},
      "spec": {"storageClassName": "gp3-retain", "accessModes": ["ReadWriteOnce"]}
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {"name": "pvc-0a1b", "labels": {"topology.kubernetes.io/zone": "eu-west-1a"}},
      "spec": {"storageClassName": "standard", "capacity": {"storage": "200Gi"}}
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {"name": "pvc-0c2d", "labels": {"failure-domain.beta.kubernetes.io/zone": "eu-west-1c"}},
      "spec": {"storageClassName": "gp3-retain", "capacity": {"storage": "20Gi"}}
    }
  ]
}
