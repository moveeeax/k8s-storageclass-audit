{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "storage.k8s.io/v1",
      "kind": "StorageClass",
      "metadata": {
        "name": "gp3",
        "annotations": {"storageclass.kubernetes.io/is-default-class": "true"}
      },
      "provisioner": "ebs.csi.aws.com",
      "reclaimPolicy": "Retain",
      "volumeBindingMode": "WaitForFirstConsumer",
      "allowVolumeExpansion": true
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {"name": "ghost", "namespace": "legacy"},
      "spec": {"storageClassName": "deleted-tier", "accessModes": ["ReadWriteOnce"]}
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {"name": "opted-out", "namespace": "legacy"},
      "spec": {"storageClassName": "", "volumeName": "manual-pv"}
    }
  ]
}
